# The documentation site (research.md R31). Committed: package.json, pnpm-lock.yaml,
# pnpm-workspace.yaml, docmd.config.mjs and scripts/docmd-include.mjs — everything else the site
# produces is derived from docs/ and is rebuilt by `pnpm build`.
/node_modules
/site

# Generated from packaging/aur/PKGBUILD by the release workflow and by `makepkg --printsrcinfo`;
# it is pushed to the AUR rather than kept here (FR-107).
/packaging/aur/.SRCINFO
