/target

# Rust
**/*.rs.bk
*.pdb

# Editors and desktops
.idea/
.vscode/
*.swp
.DS_Store

# Local environment and logs — never publish (FR-066a)
.env
.env.*
*.log

# The documentation site (research.md R31). Committed: package.json, pnpm-lock.yaml,
# pnpm-workspace.yaml, docmd.config.mjs and scripts/docmd-include.mjs — everything else the site
# produces is derived from docs/ and is rebuilt by `pnpm build`.
/node_modules
/site

# Each AUR recipe tracks only its PKGBUILD. Everything else in a recipe directory is generated:
# `.SRCINFO` by the release workflow and `makepkg --printsrcinfo`, pushed to the AUR rather than
# kept here (FR-107); and `src/`, `pkg/`, the downloaded sources and the built `*.pkg.tar.zst`
# packages by a local `makepkg`.
/packaging/aur/*/*
!/packaging/aur/*/PKGBUILD
